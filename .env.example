# Maritime Operations AI - Environment Variables
# Copy this file to .env for local overrides

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=maritime_user
POSTGRES_PASSWORD=maritime_secure_dev_password
POSTGRES_DB=maritime_ops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://maritime_user:maritime_secure_dev_password@postgres:5432/maritime_ops

# Redis (Streams, Pub/Sub, Primary Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
