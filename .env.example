# ==============================================================================
# Maritime Operations AI - Environment Configuration Template
# Copy this file to .env: cp .env.example .env
# Never commit real credentials, tokens, or private secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Core
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:80", "http://localhost"]

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16 + PostGIS 3.4)
# ------------------------------------------------------------------------------
POSTGRES_USER=maritime_user
POSTGRES_PASSWORD=maritime_secure_dev_password
POSTGRES_DB=maritime_ops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://maritime_user:maritime_secure_dev_password@postgres:5432/maritime_ops

# ------------------------------------------------------------------------------
# 3. Redis 7 (Streams, Pub/Sub, Short-Lived Caches)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. Frontend Configuration (Vite + Nginx)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 5. External Live Feeds: AISStream (Optional for Local Demo)
# Free registration at: https://aisstream.io
# If left blank, the AIS worker logs a clean warning and skips external ingestion.
# Database queries and UI will function using existing/seeded vessel records.
# ------------------------------------------------------------------------------
AISSTREAM_API_KEY=
AIS_BBOX_MIN_LAT=49.5
AIS_BBOX_MIN_LON=-2.0
AIS_BBOX_MAX_LAT=51.5
AIS_BBOX_MAX_LON=2.5

# ------------------------------------------------------------------------------
# 6. Copernicus Data Space Ecosystem (CDSE) Credentials (Optional)
# Free registration at: https://dataspace.copernicus.eu/
# Required ONLY for live Sentinel-1 satellite asset downloads & on-demand SLC burst extraction.
# If omitted, SAR catalog searches still succeed via public STAC API, offline demo
# workflows execute safely via local weights, and real SLC downloads fail cleanly.
# ------------------------------------------------------------------------------
CDSE_USERNAME=
CDSE_PASSWORD=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 7. Model Weights & Modality Defaults (Pre-tracked in repo)
# ------------------------------------------------------------------------------
SAR_MODEL_WEIGHTS_PATH=backend/ml/weights/yolo26s_sar_vessel.pt
SAR_SLC_MODEL_WEIGHTS_PATH=backend/ml/weights/yolo26s_slc_vessel.pt
SAR_DEFAULT_MODALITY=GRD
